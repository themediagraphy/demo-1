# Real HTTP security headers. GitHub Pages ignores this file; Cloudflare Pages and Netlify apply it. On GitHub Pages behind Cloudflare,
# create the same headers as a Cloudflare Transform Rule (see SECURITY.md).
/*
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-O3Mw6wi7lUhS2M3+/uXPmwP93FwCssWvBXC1MVgc9jI='; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://script.google.com https://script.googleusercontent.com; manifest-src 'self'; frame-src 'none'; worker-src 'none'; media-src 'none'; base-uri 'self'; object-src 'none'; form-action 'none'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*.txt
  Content-Type: text/plain; charset=utf-8
